{
  "$schema": "https://dev.max.ru/schemas/miniapp-manifest.json",
  "app_id": "dekanat_igu_concept",
  "name": "Цифровой деканат ИГУ (Концепт)",
  "short_name": "Деканат",
  "description": "Мобильный цифровой деканат: расписание, зачетка, онлайн-заказ справок и регламентный ИИ-помощник для студентов ИГУ.",
  "version": "1.0.0",
  "author": "Захар",
  "category": "education",
  "web_app": {
    "url": "https://153.51.174.89.sslip.io?platform=max",
    "theme_color": "#0f172a",
    "background_color": "#020617",
    "default_mode": "fullscreen",
    "supported_platforms": ["ios", "android", "web"],
    "safe_area_insets": true,
    "header_style": {
      "color": "dark",
      "show_back_button": true,
      "show_verified_badge": true
